# Copy to .env and fill in. Never commit .env.

# --- Meta WhatsApp Cloud API ---
# From the Meta app dashboard: WhatsApp -> API Setup.
# The token shown there is temporary (24h). For production, generate a permanent
# token via a System User in Meta Business Settings.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any random string you choose. Enter the SAME value in Meta's webhook config
# (WhatsApp -> Configuration -> Webhook -> Verify token).
WHATSAPP_VERIFY_TOKEN=

# --- Bot behaviour ---
# Numbers pinged when someone asks to talk to a human.
# Comma-separated, country code included, digits only, no "+".
STAFF_NOTIFY_NUMBERS=

# Used in the bot's own messages. Defaults to "the art school".
SCHOOL_NAME=Artistic Ruban's

# --- Server ---
# Defaults to 3000.
PORT=3000

# SQLite file. Defaults to ./data/artschool.db.
# On a host like Railway or Render, point this at a mounted persistent volume
# (e.g. /data/artschool.db) or the database resets on every deploy.
DATABASE_PATH=./data/artschool.db

# Needed when setting up the Meta app, but not read by this code.
# WHATSAPP_BUSINESS_ACCOUNT_ID=
